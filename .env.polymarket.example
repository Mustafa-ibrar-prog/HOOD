# Copy this file's values into your real .env (or export them directly).
# Never commit a real .env file, and NEVER paste a real private key into
# a chat session, an issue, a commit message, or anywhere other than a
# local environment variable / gitignored .env file.
#
# ==============================================================================
# SAFETY — same two-independent-switches pattern as the Robinhood side's
# TRADING_MODE/LIVE_TRADING_CONFIRMED (.env.example). Read
# src/polymarket/gateway.py's module docstring before changing either.
# ==============================================================================
# "paper" (default) -> no real order is ever placed; every "submission" is
#   simulated in-process and only ever written to the decision log.
# "live" -> real order placement IS implemented, but:
#   - It does nothing by itself. POLYMARKET_LIVE_TRADING_CONFIRMED must
#     ALSO be true, or LivePolymarketGateway refuses to even construct.
#   - Even then, every order stops at "pending_approval" unless
#     POLYMARKET_LIVE_AUTO_EXECUTE is ALSO true — see below.
#   - The emergency-stop file (POLYMARKET_EMERGENCY_STOP_FILE) defaults
#     to STOPPED with no file present. A real order cannot place until
#     someone explicitly clears it — see EmergencyStopStore.clear() in
#     src/execution/emergency_stop.py (reused as-is for Polymarket).
POLYMARKET_TRADING_MODE=paper

# Second, independent confirmation gate. Even with TRADING_MODE=live,
# nothing real happens until this is also explicitly true.
POLYMARKET_LIVE_TRADING_CONFIRMED=false

# Whether a pending order places automatically once the risk gate
# clears (true), or requires a separate, explicit confirm_and_place()
# call every single time (false, the default and the recommended
# setting until you've watched this trade for a while in live mode
# with auto-execute off).
POLYMARKET_LIVE_AUTO_EXECUTE=false

# ==============================================================================
# VENUE — Polymarket US and international polymarket.com are GENUINELY
# DIFFERENT systems (different base URLs, different official SDK,
# different auth model — see us_client.py's module docstring for the
# full verification trail). Pick exactly one.
# ==============================================================================
# "international" (the default here, for backward compatibility with
#   any config that predates the US venue) -> client.py,
#   polymarket-client, POLYMARKET_PRIVATE_KEY/API_KEY/... below.
# "us" -> us_client.py, polymarket-us, POLYMARKET_US_KEY_ID/SECRET_KEY
#   below. A US-based trader should set this explicitly.
POLYMARKET_VENUE=us

# ==============================================================================
# CREDENTIALS — INTERNATIONAL VENUE ONLY (POLYMARKET_VENUE=international).
# Ignored entirely when POLYMARKET_VENUE=us — see the US credentials
# section further below instead. See src/polymarket/settings.py's and
# client.py's module docstrings for the full verification trail against
# polymarket-client's real SecureClient.create() signature.
# ==============================================================================
# ALWAYS REQUIRED for live trading (POLYMARKET_TRADING_MODE=live) — not
# optional, and NOT substitutable by the API key triple below. Every
# order is an EIP-712 signature from this wallet; settings.py's
# fail-closed validation refuses to start in live mode without it. This
# key controls real funds — treat it exactly like the funds themselves.
# NEVER paste a real value into a chat session, an issue, a commit
# message, or anywhere other than a local environment variable /
# gitignored .env file.
POLYMARKET_PRIVATE_KEY=

# OPTIONAL pre-derived L2 API credentials — purely a startup-latency
# optimization (skips re-deriving them via a signed request every
# process start). If left blank, the SDK derives them itself from
# POLYMARKET_PRIVATE_KEY at startup; either way, POLYMARKET_PRIVATE_KEY
# above is still required for live trading. These three must be ALL set
# or ALL blank — a partial set is always a configuration mistake and
# settings.py rejects it at startup rather than guessing which one you
# meant to set.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Optional: the wallet to trade on behalf of, when it differs from the
# private key's own address (e.g. a Polymarket-issued proxy/Safe
# wallet). Leave blank to trade directly as the private key's address.
POLYMARKET_FUNDER_ADDRESS=

# There is no POLYMARKET_CLOB_API_URL / GAMMA_API_URL / CHAIN_ID here on
# purpose (an earlier version of this file had them). The SDK bundles
# those into one `Environment` (currently only PRODUCTION is
# supported/used — see client.py); letting them be set independently
# risked a real mismatch (an overridden host paired with the wrong
# chain_id). There is currently no supported way to point this system
# at anything other than real, production Polymarket.

# ==============================================================================
# CREDENTIALS — US VENUE ONLY (POLYMARKET_VENUE=us). Ignored entirely
# when POLYMARKET_VENUE=international. See us_client.py's module
# docstring for the full verification trail against the installed
# polymarket-us SDK's real PolymarketUS.__init__ and
# auth.create_auth_headers().
# ==============================================================================
# Polymarket US uses Ed25519 signature auth — a UUID key_id plus a
# base64-encoded Ed25519 secret_key, NOT an EVM private key. There is
# no wallet/funder concept on this venue at all. Generate these at
# https://polymarket.us/developer after your account is verified.
# BOTH are ALWAYS REQUIRED for live trading (POLYMARKET_TRADING_MODE=live
# with POLYMARKET_VENUE=us) and must be both set or both blank —
# settings.py's fail-closed validation rejects a partial pair. This
# secret_key controls real funds — treat it exactly like the funds
# themselves. NEVER paste a real value into a chat session, an issue, a
# commit message, or anywhere other than a local environment variable /
# gitignored .env file.
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=

# Base URLs — verified directly from the installed polymarket-us SDK's
# own PolymarketUS.__init__ defaults. Override only if Polymarket US
# ever documents a sandbox/testnet environment (none is known to exist
# as of this writing).
POLYMARKET_US_API_BASE_URL=https://api.polymarket.us
POLYMARKET_US_GATEWAY_BASE_URL=https://gateway.polymarket.us

# TEMPORARY, test-only manual market override (POLYMARKET_VENUE=us only).
# Leave this UNSET — unset is the default, and leaves automatic BTC 15m
# discovery (find_active_btc_market()) completely unaffected. When set to
# an exact market or event slug you copied yourself from the Polymarket US
# app, find_active_btc_market() retrieves ONLY that exact slug instead of
# running BTC discovery — no search, no "closest available," no fallback.
# This exists to test the real order/fill pipeline end to end against one
# market you chose, independent of whether BTC 15m discovery is currently
# working. See scripts/verify_polymarket_setup.py --market-slug and
# scripts/manual_polymarket_us_test.py; settings.py's module docstring on
# us_market_slug has the full detail.
POLYMARKET_US_MARKET_SLUG=

# US venue API resilience: bounded retry/backoff for a 429
# polymarket_us.errors.RateLimitError on a READ-ONLY call (market
# discovery, order book, settlement, fill lookup, balance) -- NEVER
# order submission, which is never automatically retried. Added after
# a real incident (Cloudflare 1015 on gateway.polymarket.us) crashed
# the bot via an uncaught RateLimitError out of get_order_book(). See
# us_client.py's _retry_on_rate_limit. Defaults below are deliberately
# modest -- raising them means waiting longer before a cycle safely
# sits out a persistent rate limit, not raising them means giving up
# sooner; neither direction changes request frequency, which this
# never increases.
POLYMARKET_US_RATE_LIMIT_MAX_RETRIES=4
POLYMARKET_US_RATE_LIMIT_BASE_DELAY_SECONDS=0.5
POLYMARKET_US_RATE_LIMIT_MAX_DELAY_SECONDS=8.0

# ==============================================================================
# RISK CONTROLS — these defaults are deliberately tiny placeholders, not
# a recommendation. Read and set every one of these yourself before
# POLYMARKET_TRADING_MODE=live.
# ==============================================================================
# Maximum USD size of any single bet.
POLYMARKET_MAX_BET_USD=5.0

# Maximum realized loss allowed in a single UTC day before new entries
# are blocked (existing open positions still settle normally).
POLYMARKET_MAX_DAILY_LOSS_USD=20.0

# Maximum concurrent open positions (across all 15-minute markets).
POLYMARKET_MAX_OPEN_POSITIONS=1

# Minimum seconds between closing a position and opening a new one.
POLYMARKET_COOLDOWN_SECONDS_AFTER_EXIT=60

# Maximum age (seconds) of the market quote used for a trade decision.
# Kept tight (20s) relative to the Robinhood side's 90s default because
# a 15-minute market moves much faster relative to its own duration.
POLYMARKET_STALE_DATA_MAX_SECONDS=20.0

# Maximum bid/ask spread (as a fraction of mid-price) to enter at.
# check_spread() (risk.py) passes on EITHER this OR
# POLYMARKET_MAX_SPREAD_USD below, not just this one — a low-priced
# binary contract (price near 0 or 1) has a tiny mid, so a perfectly
# tradeable couple-cent spread can read as a huge relative percentage
# here on its own.
POLYMARKET_MAX_SPREAD_PCT=0.05

# Companion ABSOLUTE spread cap (price/USD terms, e.g. 0.03 = 3 cents),
# checked as an alternative passing path to POLYMARKET_MAX_SPREAD_PCT
# above, not a replacement for it -- see risk.py's check_spread()
# docstring. Keep this small and tight: relative spread is
# mathematically >= absolute spread for any mid in (0, 1], so this can
# only ever rescue a genuinely tight absolute spread on a low-priced
# contract; it can never let through a trade that's wide by both
# measures.
POLYMARKET_MAX_SPREAD_USD=0.03

# Minimum EXECUTABLE liquidity (USD), precisely defined (Task 6): the
# notional (price x size) summed across order-book levels priced at or
# below the order's max_price ceiling, on the specific side (asks for a
# BUY) of the SPECIFIC outcome token actually being bought — never an
# aggregate across both outcomes, and never inferred from the other
# side's book (e.g. NO is never approximated as `1 - YES`). See
# models.OrderBookSnapshot.executable_liquidity_usd() and
# risk.py's check_order_book_liquidity(). A trade is refused outright
# if the book can't absorb it near our own ceiling price. $10 (not $25)
# -- a more realistic floor for this system's $5 default max bet.
POLYMARKET_MIN_ORDER_BOOK_LIQUIDITY_USD=10.0

# How far (as a fraction of the reference price) a new order's
# max_price ceiling is allowed to sit above the real current best ask
# — this, not POLYMARKET_MAX_SPREAD_PCT, is what bounds slippage on the
# actual order sent to the exchange.
POLYMARKET_MAX_PRICE_SLIPPAGE_PCT=0.03

# FOK (fill-or-kill, the default) either fills the ENTIRE order at a
# price no worse than max_price, or nothing happens at all — this is
# what makes "placed" and "filled" unambiguous for a new entry (Task
# 3). FAK (fill-and-kill) fills what it can and cancels the rest;
# reconciliation.py handles either correctly, but FAK reintroduces the
# "how much of this actually filled" question FOK exists to avoid.
POLYMARKET_DEFAULT_ORDER_TYPE=FOK

# ==============================================================================
# EVIDENCE-GATED DYNAMIC EXIT — see src/polymarket/exit_manager.py's module
# docstring for the full design, and btc_intelligence.py for the BTC/
# Polymarket market-assessment engine behind it. An open position's EARLY
# exit, before its 15-minute market even closes; hold-to-resolution
# settlement (engine.settle_resolved_positions) remains the fallback
# whenever a position's thesis never weakens AND its soft target is never
# reached in time. Nothing here alters MAX_BET_SIZE/MAX_DAILY_LOSS/
# MAX_SPREAD/ORDER_BOOK_LIQUIDITY/ENTRY_CUTOFF, emergency-stop behavior, or
# the existing BUY path.
#
# IMPORTANT: reaching POLYMARKET_PROFIT_TARGET_PCT is DELIBERATELY NOT an
# unconditional sell trigger. It's one input to an evidence-gated cascade
# (reusing src/strategy/evidence.py's evaluate_momentum() via
# btc_intelligence.py): HOLD while real BTC evidence still shows the move
# strengthening, even past target; EXIT early on weakening/reversal
# evidence even below target; HOLD when there isn't yet enough real BTC
# evidence to say anything (never guessed).
#
# REAL BTC SPOT DATA — two sources now exist, both feeding the SAME
# BtcPriceHistoryStore (see btc_market_data.py):
#   1. UNATTENDED, automatic (the normal path): scripts/run_polymarket_bot.py
#      wires up CoinbaseBtcQuoteSource (btc_coinbase_source.py) --
#      Coinbase Exchange's public, unauthenticated candles API, a plain
#      HTTPS call with no agent/MCP dependency. It bootstraps real
#      history on startup and refreshes automatically every new
#      1-minute candle, completely independent of this bot's own
#      POLYMARKET_POLL_INTERVAL_SECONDS cadence.
#   2. Manual/agent-assisted (the interim bridge, still available):
#      mcp__HOOD__get_crypto_quotes can only be called from an agent's
#      own tool-call turn. `python3 scripts/feed_btc_quote.py feed
#      --price <mark_price>` records one sample from it.
# Either way, until there is real, FRESH history, the BTC evidence
# engine honestly reports INSUFFICIENT_DATA and the dynamic-exit
# cascade HOLDs every cycle, falling back to the soft-target-off path
# and eventually resolution. A feed that built real history and then
# went silent is caught the SAME way — see POLYMARKET_BTC_MAX_BAR_AGE_SECONDS
# below — never kept deciding from stale data. This is intentional,
# not a bug: no real, CURRENT evidence means no action, never a guess.
# ==============================================================================

# THE master switch for the ENTIRE dynamic-exit feature (decision-making
# AND submission, in both paper and live mode). false (the default) makes
# check_and_execute_dynamic_exits() a complete no-op -- it never even
# evaluates an open position. Ships disabled; turn on explicitly once
# ready to observe it (start in paper mode).
POLYMARKET_DYNAMIC_EXIT_ENABLED=false

# The SOFT profit-target reference price: avg_fill_price * (1 + this).
# See the cascade description above -- this alone never triggers a sell.
# The REALIZED P&L actually recorded once a fill happens is always NET of
# whatever entry/exit fees the exchange reports (see FillResult.fee_usd),
# never assumed profitable from a gross move alone.
POLYMARKET_PROFIT_TARGET_PCT=0.20

# Minimum number of corroborating BTC weakening/reversing signals
# required before an early (below-target) exit is recommended -- same
# default (2) as the proven options-side position-monitor's
# EvaluatorConfig.min_weakening_signals_for_exit, reused rather than
# independently re-tuned. A barely-WEAKENING read (one soft signal) must
# never be enough on its own.
POLYMARKET_MIN_WEAKENING_SIGNALS_FOR_EXIT=2

# How many seconds of fed BTC quote samples are aggregated into one OHLC
# bar for the BTC evidence engine (see btc_market_data.py). 60 (one-minute
# bars) matches this system's own poll cadence order of magnitude.
POLYMARKET_BTC_BAR_INTERVAL_SECONDS=60

# Where real BTC candles/quote samples persist -- CoinbaseBtcQuoteSource's
# bootstrap/refresh AND scripts/feed_btc_quote.py both write here;
# exit_manager.py reads from here. Restart-safe, same file-backed
# convention as every other store in this package. (Real candles are
# additionally kept in a sibling "<this>.bars.json" file, created
# automatically -- see btc_market_data.BtcPriceHistoryStore.)
POLYMARKET_BTC_PRICE_HISTORY_FILE=logs/polymarket/btc_price_history.json

# The maximum age (seconds) of the NEWEST available BTC bar before it
# is treated as equivalent to "no data at all" -- a feed that goes
# silent must become INSUFFICIENT_DATA, never keep deciding from
# arbitrarily old data forever (see btc_intelligence.assess_btc_market /
# btc_market_data.compute_feed_status). Default 300s (5 minutes): with
# 1-minute candles refreshed on every new-minute boundary, a healthy
# feed's newest bar is normally 60-120s old by the time it's read;
# 300s gives a generous ~2.5-5x margin above that (so ordinary
# jitter/a slow API response never falsely reads as STALE) while still
# catching a genuinely dead feed with most of a 15-minute market's
# life still left to react to it.
POLYMARKET_BTC_MAX_BAR_AGE_SECONDS=300

# A SECOND, independent switch from POLYMARKET_LIVE_AUTO_EXECUTE above —
# that flag is entry-only and is left completely untouched by this
# feature. In PAPER mode this has no effect either way (a paper exit
# always "fills" immediately, exactly like a paper entry). In LIVE mode:
# false (the default) means an exit the cascade approved still stops at
# "pending_approval" and needs a separate, explicit confirm_and_place()
# call (scripts/confirm_pending_order.py or confirm_polymarket_order.py,
# both already side-agnostic); true places it immediately once approved,
# subject to the SAME emergency-stop check real entries already go
# through (see gateway.py's LivePolymarketGateway._submit_pending()).
POLYMARKET_AUTO_EXIT_ENABLED=false

# ==============================================================================
# MARKET SELECTION
# ==============================================================================
POLYMARKET_ASSET=bitcoin
POLYMARKET_MARKET_DURATION_MINUTES=15

# No new entry within this many seconds of a market's close — mirrors
# the Robinhood side's ENTRY_CUTOFF_TIME in spirit: don't open a fresh
# position when there's no time left to be right. 60 (not 120) for this
# 15-minute market: a 2-minute cutoff was excluding over 13% of each
# window's entry opportunity for a market whose own duration is already
# this short.
POLYMARKET_ENTRY_CUTOFF_SECONDS_BEFORE_CLOSE=60

# ==============================================================================
# OPERATIONAL
# ==============================================================================
POLYMARKET_POLL_INTERVAL_SECONDS=10
POLYMARKET_LOG_DIR=logs/polymarket
POLYMARKET_DECISION_LOG_FILE=logs/polymarket/decisions.jsonl
POLYMARKET_PENDING_ORDERS_FILE=logs/polymarket/pending_orders.json
POLYMARKET_EMERGENCY_STOP_FILE=logs/polymarket/emergency_stop.json
POLYMARKET_DAILY_PNL_FILE=logs/polymarket/daily_pnl.json
POLYMARKET_POSITIONS_FILE=logs/polymarket/open_positions.json

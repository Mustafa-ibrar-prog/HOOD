# Copy this file to .env and adjust values. Never commit a real .env file.
#
# ==============================================================================
# SAFETY
# ==============================================================================
# TRADING_MODE must be "paper" or "live".
#
#   paper -> the system NEVER calls a real order-placement tool. All order
#            "submission" is simulated in-process and only ever written to
#            the decision/audit log.
#   live  -> Live execution IS implemented (src/execution/gateway.py's
#            LiveExecutionGateway), but it is gated on explicit per-trade
#            human approval and NEVER autonomous:
#              - submit_order() never calls place_option_order. It only
#                ever creates a "pending" order and stops.
#              - confirm_and_place() is the ONLY method in the codebase
#                that can call place_option_order, and it must only be
#                invoked after a real human has explicitly approved that
#                specific pending order.
#            Setting TRADING_MODE=live does NOT, by itself, cause a single
#            real order to be placed — every real order still requires a
#            separate, explicit human approval step every single time.
#
# Do not change this to "live" unless you understand and want the
# per-trade-approval live-execution path described above.
TRADING_MODE=paper

# Second, independent confirmation gate for the live path. Even when
# TRADING_MODE=live, LiveExecutionGateway refuses to even construct unless
# this is also explicitly true — two independent switches, so a single
# misconfiguration can't enable live order proposals.
LIVE_TRADING_CONFIRMED=false

# ==============================================================================
# RISK CONTROLS
# ==============================================================================
# Maximum number of *new* trades (position opens) allowed per trading day.
MAX_TRADES_PER_DAY=4

# Maximum realized + unrealized loss allowed in a single trading day (USD).
# Once breached, no new trades are allowed for the rest of the day.
MAX_DAILY_LOSS_USD=200

# Maximum capital (USD, premium * quantity * 100) allowed in a single new
# position.
MAX_POSITION_SIZE_USD=250

# Minutes to wait before re-entering the same underlying after an exit.
COOLDOWN_MINUTES_AFTER_EXIT=15

# Market data older than this (seconds) is considered stale and blocks both
# new entries and any exit/target/stop action derived from it.
STALE_DATA_MAX_SECONDS=90

# Maximum bid/ask spread, as a fraction of the mid price, allowed to trade
# an option contract (0.10 = 10%).
MAX_SPREAD_PCT=0.10

# Minimum option contract liquidity required to trade.
MIN_OPTION_VOLUME=50
MIN_OPTION_OPEN_INTEREST=100

# Maximum underlying move already made (as a fraction, e.g. 0.25 = 25%) from
# the strategy's reference point before a new entry is refused as "chasing".
MAX_EXTENDED_MOVE_PCT=0.25

# No NEW entries after this local time (HH:MM, 24h, in MARKET_TIMEZONE).
ENTRY_CUTOFF_TIME=15:30

# Regular market session, in MARKET_TIMEZONE.
MARKET_OPEN_TIME=09:30
MARKET_CLOSE_TIME=16:00
MARKET_TIMEZONE=America/New_York

# ==============================================================================
# MONITORING
# ==============================================================================
# Documentation only — no timer/scheduler in this codebase reads this value.
# It records the intended external cadence (a cron job / Routine / other
# scheduler is expected to invoke the monitor roughly this often during
# market hours).
MONITOR_INTERVAL_MINUTES=5

# ==============================================================================
# LOGGING / STATE
# ==============================================================================
LOG_DIR=logs
DECISION_LOG_FILE=logs/decisions.jsonl
APP_LOG_FILE=logs/app.log
RISK_STATE_FILE=logs/risk_state.json

# Ledger of positions THIS SYSTEM opened via simulated paper entries (never
# real Robinhood positions — see position_manager/store.py).
PAPER_POSITIONS_FILE=logs/paper_positions.json

# Ledger of live orders proposed but not yet (or never) placed — see
# src/execution/pending.py. Every entry/exit proposed in live mode lives
# here until a human approves, rejects, or lets it expire.
PENDING_ORDERS_FILE=logs/pending_orders.json

# How long a pending live order stays approvable before it's treated as
# stale and confirm_and_place() refuses it (minutes). A trade proposed
# against a quote from 45 minutes ago is not the same trade anymore.
PENDING_ORDER_EXPIRY_MINUTES=15

# Cross-cycle peak-price memory for the dynamic/trailing exit engine (see
# position_manager/peak_tracker.py and evaluator.py). Keyed by option_id,
# used for both paper and real (synced) positions.
PEAK_PRICES_FILE=logs/peak_prices.json

# Tracks which real (Robinhood-synced) positions THIS SYSTEM itself opened
# via a confirmed live order, so the position monitor only ever proposes
# exit orders for its own positions — never for something the user opened
# manually outside this system. See src/execution/live_positions.py.
LIVE_BOT_POSITIONS_FILE=logs/live_bot_positions.json

# Append-only "teaching moment" record: one entry per CLOSED trade (paper or
# live), with a deterministic, evidence-derived lesson string. NOT a
# learning system — nothing here ever mutates RiskManager's limits or the
# strategy's thresholds; see src/logging/trade_journal.py's module
# docstring for why that's a hard requirement, not a style choice.
TRADE_JOURNAL_FILE=logs/trade_journal.jsonl

# False (default): every live order stops at "pending approval" and needs
# a separate, later, explicit step to actually place it (see
# src/execution/gateway.py).
# True: a live order is placed the instant it clears every deterministic
# risk check (RiskManager + PositionEvaluator), with no conversational
# per-trade approval step. Only takes effect together with
# TRADING_MODE=live and LIVE_TRADING_CONFIRMED=true — flipping this alone
# changes nothing.
LIVE_AUTO_EXECUTE=false

# ==============================================================================
# DYNAMIC / TRAILING EXIT
# ==============================================================================
# Once an open position's unrealized gain reaches this fraction of the
# distance from entry price to its profit-target price, trailing
# protection "arms" for that position. Example: entry $0.95, target $1.15
# (a $0.20 range) — 0.5 arms at $1.05.
TRAILING_ARM_FRACTION=0.5

# Once armed, an EXIT triggers the moment price gives back this fraction of
# the gain made from entry to the position's peak price so far — rather
# than waiting for the original profit target or a momentum-evidence
# signal. Example: peak reaches $1.05 (a $0.10 gain from a $0.95 entry);
# 0.3 triggers an exit if price falls back to $1.02 (30% of that $0.10
# given back).
TRAILING_GIVEBACK_FRACTION=0.3

# ==============================================================================
# BROKERAGE ACCOUNT / SCANNING
# ==============================================================================
# Required for the orchestrator to run a cycle at all: used for read-only
# position sync (get_option_positions) and to shape the (always paper/
# simulated) order requests this system builds. Never auto-selected from
# get_accounts by code — pick the account explicitly. Must be an
# agentic_allowed=true account with option trading enabled.
ROBINHOOD_ACCOUNT_NUMBER=

# Comma-separated underlying symbols the scanner considers each cycle.
SCAN_UNIVERSE=SPY,QQQ,AAPL,MSFT,NVDA

# Maximum number of new paper positions opened in a single cycle (on top of
# MAX_TRADES_PER_DAY, which caps the whole day). 0 disables scanning/entries
# entirely — the system will still monitor and exit existing positions.
MAX_NEW_ENTRIES_PER_CYCLE=1

# Profit target / stop loss applied to positions synced read-only from the
# real Robinhood account (opened by the user outside this system, so there
# is no known trader-set target/stop to sync) — expressed as a fraction of
# the position's cost basis. See position_manager/hood_sync.py.
SYNCED_POSITION_PROFIT_TARGET_PCT=0.50
SYNCED_POSITION_STOP_LOSS_PCT=0.50

# ClipForge backend configuration. Copy to backend/.env (never commit real keys).
# Every variable is optional; defaults are shown.

# ---------------------------------------------------------------- moment analysis
# auto | anthropic | openai | heuristic
#   auto = anthropic if ANTHROPIC_API_KEY is set, else openai if OPENAI_API_KEY is set, else heuristic (free, offline)
ANALYSIS_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = more thorough, more output tokens)
ANTHROPIC_EFFORT=medium
# Server-side refusal fallbacks (beta) for models that support them
ANTHROPIC_FALLBACKS=true
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works (e.g. a local Ollama/vLLM server)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------- transcription
# auto | youtube_captions | faster_whisper | openai
#   auto = human captions -> faster-whisper (if installed) -> OpenAI STT (if keyed) -> YouTube auto-captions
TRANSCRIPTION_PROVIDER=auto
TRANSCRIPT_LANGUAGE=en
# faster-whisper model: tiny | base | small | medium | large-v3   (downloaded from Hugging Face on first use)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ---------------------------------------------------------------- ingestion
# 0 = no limit on source video length
MAX_VIDEO_SECONDS=0
MAX_DOWNLOAD_HEIGHT=1080
DOWNLOAD_RETRIES=3

# ---------------------------------------------------------------- rendering
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
X264_PRESET=veryfast
X264_CRF=20
FFMPEG_TIMEOUT_SECONDS=900
DEFAULT_MAX_CLIPS=8

# ---------------------------------------------------------------- jobs & storage
CLIPFORGE_DATA_DIR=./data
WORKER_THREADS=2
# Finished jobs older than this are deleted at startup and by POST /api/cleanup
RETENTION_HOURS=48
# local | s3   (s3 needs `pip install boto3` and AWS credentials in the environment)
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=clipforge/
CORS_ORIGINS=http://localhost:5173
